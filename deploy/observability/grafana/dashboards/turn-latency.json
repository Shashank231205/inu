{
  "uid": "inu-turn-latency",
  "title": "INU: turn latency",
  "description": "Per-stage and whole-turn latency against the NFR-1 budget (p50 < 700 ms, p95 < 900 ms end of speech to first audio).",
  "tags": [
    "inu",
    "latency"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "inu-prometheus"
        },
        "query": {
          "query": "label_values(inu_stage_duration_milliseconds_count, instance)",
          "refId": "instance"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Stage latency p95",
      "description": "95th percentile duration of each stage (stt, route, llm, tts, ...). Dots are exemplars: click one to open that turn's trace.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "inu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, inu_stage) (rate(inu_stage_duration_milliseconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{inu_stage}}",
          "exemplar": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Stage latency p50",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "inu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, inu_stage) (rate(inu_stage_duration_milliseconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{inu_stage}}",
          "exemplar": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Whole turn p50 / p95",
      "description": "Red line: the NFR-1 p95 budget.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "inu-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(inu_turn_duration_milliseconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "exemplar": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(inu_turn_duration_milliseconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "exemplar": true
        }
      ]
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Stage outcomes in range",
      "description": "ok, or the InuError code / exception type that ended the stage.",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "inu-prometheus"
      },
      "options": {
        "orientation": "horizontal",
        "stacking": "normal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (inu_stage, inu_outcome) (increase(inu_stage_duration_milliseconds_count{instance=~\"$instance\"}[$__range]))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "inu_outcome",
            "rowField": "inu_stage",
            "valueField": "Value"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "text",
      "title": "Traces",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Click an exemplar dot on a latency graph to open that turn's trace here in Grafana.\n\nTo browse or search all turns, use the [Jaeger UI](http://127.0.0.1:16686/search?service=inu&operation=turn). Grafana 13's Jaeger plugin still searches through `/api/traces`, which Jaeger 2.21 removed, so search lives in Jaeger itself (ADR 0007)."
      }
    }
  ]
}
